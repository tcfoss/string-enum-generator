<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <PrivateAssets>all</PrivateAssets>
    <LanguageVersion>latest</LanguageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TcfOss.StringEnumGenerator</PackageId>
    <Description>Source generator for StringEnum classes based on the StringEnum attribute</Description>
    <Authors>Thomas C. Flanagan</Authors>
    <PackageTags>source-generator;analyzer;stringenum</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TcfOss.DataStructures" Version="1.0.13" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyDataStructuresDll" AfterTargets="Build">
    <ItemGroup>
      <_DataStructuresDll Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'TcfOss.DataStructures'" />
    </ItemGroup>
    <Copy SourceFiles="@(_DataStructuresDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Condition="Exists('$(OutputPath)$(AssemblyName).dll')" />
    <None Include="$(OutputPath)TcfOss.DataStructures.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Condition="Exists('$(OutputPath)TcfOss.DataStructures.dll')" />
  </ItemGroup>

</Project>