{
  "$schema": "https://raw.githubusercontent.com/microsoft/testfx/main/docs/testconfig.schema.json",
  "platformOptions": {
    "Coverlet": {
      "format": "cobertura",
      "excludeByFile": "**/*.g.cs",
      "exclude": "[System.Text.*]*,[*.Tests]*,[*.IntegrationTests]*",
      "excludeByAttribute": "ExcludeFromCodeCoverage,GeneratedCode",
      "skipAutoProps": true
    }
  }
}