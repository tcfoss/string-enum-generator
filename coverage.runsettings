<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- File exclusions: Generated sources -->
          <!-- Coverlet ExcludeByFile uses semicolon-separated globs     -->
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>

          <!-- Assembly/module exclusions: glob patterns, no regex        -->
          <!-- Coverlet matches on assembly name, not filename            -->
          <Exclude>[System.Text.*]*,[Testcontainers*]*,[MySqlConnector*]*,[Docker.DotNet*]*,[*.Tests]*,[*.IntegrationTests]*</Exclude>

          <!-- Coverlet respects these automatically, but explicit is fine -->
          <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCode</ExcludeByAttribute>

          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
  <RunConfiguration>
    <ResultsDirectory>./test-results</ResultsDirectory>
  </RunConfiguration>
</RunSettings>